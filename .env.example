# ══════════════════════════════════════════════════════════════════════════
# Midnight Oracle — Environment Variables
# 1. Copy this file to .env
# 2. Fill in your real values
# 3. NEVER commit .env to git — set these in Render's Environment tab
# ══════════════════════════════════════════════════════════════════════════

# ── Telegram ───────────────────────────────────────────────────────────────
# @BotFather → /revoke old token first, then /newbot
BOT_TOKEN=

# Your Telegram user ID (not username). Get it from @userinfobot
OWNER_ID=

# Your group's chat ID. Negative number e.g. -1001234567890
# Send /id in your group after adding the bot to get this.
GROUP_CHAT_ID=

# ── Gemini AI ──────────────────────────────────────────────────────────────
# Free at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Current stable workhorse examples: gemini-3.7-flash or gemini-2.5-flash
# The runtime can discover a compatible generateContent model after a 404.
GEMINI_MODEL=gemini-3.7-flash

# ── Upstash Redis ──────────────────────────────────────────────────────────
# Free tier at https://console.upstash.com
# Use the REST URL (starts with https://), NOT the redis:// URL
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── GIPHY ──────────────────────────────────────────────────────────────────
# Free at https://developers.giphy.com
GIPHY_API_KEY=

# ── Render / Server ────────────────────────────────────────────────────────
PORT=10000
# Your Render service URL e.g. https://mdnt-oracle-bot.onrender.com
RENDER_EXTERNAL_URL=

# ── Timezone & Oracle Cycle ────────────────────────────────────────────────
ORACLE_TZ=Asia/Kolkata
ORACLE_CYCLE_HOURS=24
ORACLE_CYCLE_START_HOUR=6
ORACLE_CYCLE_START_MINUTE=30
