# Never commit real credentials. Set these in Render's environment settings.
BOT_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
GIPHY_API_KEY=
PORT=10000
ORACLE_TZ=Asia/Kolkata
# Optional: default word that wakes Midnight in group chat.
MIDNIGHT_TRIGGER=midnight
# Private owner control. Set this to the Telegram numeric ID of the bot owner.
# It is never shown in Midnight's public command menus.
MIDNIGHT_OWNER_ID=
# Optional: comma-separated Telegram channel IDs Midnight should react to.
# The channel needs a linked discussion group and the bot must be allowed to comment.
MIDNIGHT_ASSOCIATED_CHANNELS=

# Midnight Radio / Voice Chat
# These belong to a dedicated Telegram user/assistant MTProto session, not BOT_TOKEN.
# Generate a session string for the dedicated assistant account; never commit it.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_STRING=
