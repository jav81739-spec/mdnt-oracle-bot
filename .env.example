# ══════════════════════════════════════════════════════════════════════════
# Midnight Oracle — Environment Variables
# Put real values in Render Environment, never commit secrets.
# ══════════════════════════════════════════════════════════════════════════

# ── Telegram ───────────────────────────────────────────────────────────────
BOT_TOKEN=
OWNER_ID=
GROUP_CHAT_ID=

# ── Gemini AI ──────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── Upstash Redis ──────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── GIPHY ──────────────────────────────────────────────────────────────────
GIPHY_API_KEY=

# ── Render / Server ────────────────────────────────────────────────────────
PORT=10000
RENDER_EXTERNAL_URL=

# ── Oracle timing ──────────────────────────────────────────────────────────
ORACLE_TZ=Asia/Kolkata
ORACLE_CYCLE_HOURS=24
ORACLE_CYCLE_START_HOUR=6
ORACLE_CYCLE_START_MINUTE=30

# ── Autonomous delivery governor ───────────────────────────────────────────
# Minimum time between unsolicited Oracle messages in the same room.
ORACLE_ROOM_COOLDOWN=1800
# Wild Signal only speaks in active rooms and no more than once per 6 hours.
ORACLE_WILD_COOLDOWN=21600
